# Copy to .env.local and fill in real values. Never commit .env.local.
# Clerk authentication (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
# PostgreSQL connection string (required; Neon compatible)
DATABASE_URL=postgresql://user:password@host:port/database
# Public base URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Upstash Redis for production rate limiting
# (the in-memory limiter is used when these are unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: rate limit tuning (defaults: 10 requests per 60 seconds)
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
